# --- Required ---------------------------------------------------------------------------
# Local:  mongodb://localhost:27017        Atlas: the mongodb+srv://... string for a database
# user that can access ONLY the FoodAtlas database (Atlas > Database Access > restrict to one database).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=FoodAtlas
FIREBASE_PROJECT_ID=your-firebase-project-id
CORS_ORIGINS=http://localhost:5173

# "production" hides /docs and /openapi.json (they would advertise the private admin routes)
APP_ENV=development

# --- Admin review (SecureAccess) --------------------------------------------------------
# The PUBLIC key printed by SecureAccess' `python -m app.scripts.generate_signing_keys`.
# Paste it as one line, using \n where the line breaks are. Leave empty to switch the admin API off.
# This is NOT a secret (it can only verify tokens, never create them).
SECUREACCESS_PUBLIC_KEY=
SECUREACCESS_ISSUER=secureaccess
ADMIN_TOKEN_AUDIENCE=food-atlas-admin

# --- Abuse limits per user ----------------------------------------------------------------
MAX_PENDING_PER_USER=5
MAX_SUBMISSIONS_PER_DAY=10
