# MongoDB Atlas connection string (URL-encode special characters in the password)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=FoodAtlas

# Firebase project ID (Firebase console > Project settings > General). It is public, not a secret.
FIREBASE_PROJECT_ID=

# Frontend origin(s), comma separated (add your deployed URL later)
CORS_ORIGINS=http://localhost:5173

# Emails (comma separated) that may edit/delete any restaurant. Must be verified in Firebase.
ADMIN_EMAILS=
