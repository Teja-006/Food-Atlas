# Leave empty in development (Vite proxies /api to localhost:8000).
# In production, set to your deployed API URL, e.g. https://food-atlas-api.onrender.com
VITE_API_URL=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=